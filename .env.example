# Supabase Project Configuration
SUPABASE_PROJECT_ID=example
SUPABASE_PUBLISHABLE_KEY=example
SUPABASE_URL=example

# Server only, required by /admin to create and delete accounts.
SUPABASE_SERVICE_ROLE_KEY=example

# Client-side (Vite) Environment Variables
VITE_SUPABASE_PROJECT_ID=example
VITE_SUPABASE_PUBLISHABLE_KEY=example
VITE_SUPABASE_URL=example